@model List<RaceDay.Web.Controllers.ManagementController.EnrolmentRow>
@{ViewData["Title"]="Enrolments";int eventId=(int)ViewBag.EventId;}<h1 class="fw-bold">Participant enrolments</h1><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Enrolled</th><th>Status</th><th>Record result</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="badge @(e.Status=="Confirmed"?"bg-success":"bg-warning text-dark")">@e.Status</span></td><td><form asp-action="SaveResult" method="post" class="d-flex gap-1"><input type="hidden" name="eventId" value="@eventId"/><input type="hidden" name="enrolmentId" value="@e.EnrolmentID"/><input name="finishPosition" type="number" min="1" placeholder="Position" class="form-control form-control-sm"/><input name="finishTime" type="time" step="1" class="form-control form-control-sm"/><select name="resultStatus" class="form-select form-select-sm"><option>Finished</option><option>DNF</option><option>DNS</option><option>Disqualified</option></select><button class="btn btn-sm btn-dark">Save</button></form></td></tr>}</tbody></table></div>
