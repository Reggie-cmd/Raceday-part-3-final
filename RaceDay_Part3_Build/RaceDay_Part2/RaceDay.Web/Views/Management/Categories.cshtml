@model List<RaceDay.Web.Controllers.ManagementController.CategoryRow>
@{ViewData["Title"]="Categories";int eventId=(int)ViewBag.EventId;}<h1 class="fw-bold">Event categories</h1><div class="row g-4"><div class="col-lg-7"><div class="list-group">@foreach(var c in Model){<div class="list-group-item"><strong>@c.CategoryName</strong> · @c.AgeGroup · R @c.EntryFee.ToString("0.00")</div>}</div></div><div class="col-lg-5"><div class="card card-body"><h4>Add category</h4><form asp-action="AddCategory" method="post"><input type="hidden" name="eventId" value="@eventId"/><label class="form-label">Category name</label><input name="CategoryName" class="form-control mb-2" required/><label class="form-label">Age group</label><input name="AgeGroup" class="form-control mb-2"/><label class="form-label">Entry fee (ZAR)</label><input name="EntryFee" type="number" min="0" step="0.01" class="form-control mb-2"/><label class="form-label">Maximum participants</label><input name="MaxParticipants" type="number" min="1" class="form-control mb-3"/><button class="btn btn-warning">Add category</button></form></div></div></div>
