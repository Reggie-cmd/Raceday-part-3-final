@model EventVm
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control mb-3"/><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control mb-3"></textarea><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control mb-3"/><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" type="time" class="form-control mb-3"/><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control mb-3"/><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" class="form-control mb-3"/><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select mb-3"><option>Running</option><option>Walking</option><option>Cycling</option></select><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select mb-3"><option>Open</option><option>Closed</option><option>Cancelled</option><option>Completed</option></select><button class="btn btn-warning">Save event</button></form>
