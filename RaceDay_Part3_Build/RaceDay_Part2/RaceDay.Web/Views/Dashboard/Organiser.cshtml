@{ViewData["Title"]="Organiser dashboard";var events=ViewBag.Events as List<RaceDay.Web.Controllers.DashboardController.EventItem>??new();}<div class="d-flex justify-content-between align-items-center mb-4"><div><span class="eyebrow">ORGANISER HQ</span><h1 class="fw-bold">Your events</h1><p class="text-secondary">Manage your race calendar and participants.</p></div><a class="btn btn-warning" asp-controller="Events" asp-action="Create">+ Create event</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><span>Events created</span><strong>@events.Count</strong></div></div><div class="col-md-4"><div class="stat-card"><span>Upcoming events</span><strong>@events.Count(x=>x.EventDate>=DateTime.Today)</strong></div></div><div class="col-md-4"><div class="stat-card"><span>Role</span><strong>Organiser</strong></div></div></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Enrolments</th><th>Status</th><th>Manage</th></tr></thead><tbody>@foreach(var e in events){<tr><td class="fw-semibold">@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.EnrolmentCount</td><td><span class="badge bg-success">@e.Status</span></td><td><a asp-controller="Events" asp-action="Edit" asp-route-id="@e.EventID">Edit</a> · <a asp-controller="Management" asp-action="Categories" asp-route-eventId="@e.EventID">Categories</a> · <a asp-controller="Management" asp-action="Enrolments" asp-route-eventId="@e.EventID">Enrolments / results</a> <form asp-controller="Events" asp-action="Delete" asp-route-id="@e.EventID" method="post" class="d-inline" onsubmit="return confirm('Delete this event?')"><button class="btn btn-link btn-sm text-danger">Delete</button></form></td></tr>}</tbody></table></div>
