<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-expand-lg navbar-dark rd-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>@if(Context.Session.GetString("Role")=="Organiser"){<li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Create">Create event</a></li>}@if(Context.Session.GetString("Role")=="Participant"){<li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">My enrolments</a></li><li class="nav-item"><a class="nav-link" asp-controller="Results" asp-action="Index">My results</a></li>}</ul><ul class="navbar-nav">@if(Context.Session.GetInt32("UserId")!=null){<li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">@Context.Session.GetString("UserName") · Profile</a></li><li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light mt-1">Log out</button></form></li>}else{<li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li><li class="nav-item"><a class="btn btn-warning btn-sm mt-1" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>}</ul></div></div></nav><main class="container py-4"><partial name="_Flash"/>@RenderBody()</main><footer class="container py-4 text-secondary small">© @DateTime.Now.Year RaceDay · Run your race. Own your finish.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",false)</body></html>
