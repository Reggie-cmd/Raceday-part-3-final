@model List<RaceDay.Web.Controllers.ResultsController.ResultRow>
@{ViewData["Title"]="My results";}<span class="eyebrow">YOUR PERSONAL RACE HISTORY</span><h1 class="fw-bold">My results</h1><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Enrolment.Category.Event.EventName</td><td>@r.Enrolment.Category.Event.EventDate.ToString("dd MMM yyyy")</td><td>@r.Enrolment.Category.CategoryName</td><td>@(r.FinishTime?.ToString()??"—")</td><td>@(r.FinishPosition?.ToString()??"—")</td><td>@r.ResultStatus</td></tr>}</tbody></table></div>
