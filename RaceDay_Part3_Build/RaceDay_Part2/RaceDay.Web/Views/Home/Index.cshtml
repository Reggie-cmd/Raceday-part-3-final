@model List<RaceDay.Web.Controllers.HomeController.EventCard>
@{ViewData["Title"]="Discover events";}<section class="hero p-4 p-md-5 mb-4"><span class="eyebrow">YOUR NEXT START LINE</span><h1 class="display-5 fw-bold mt-2">Find your pace.<br/>Make your mark.</h1><p class="lead">Discover running, walking and cycling events around you.</p><a class="btn btn-warning btn-lg" href="#events">Explore events</a></section><div class="d-flex justify-content-between align-items-end mb-3" id="events"><div><span class="eyebrow">THE RACE CALENDAR</span><h2 class="fw-bold mb-0">Upcoming events</h2></div><span class="text-secondary">@Model.Count event(s)</span></div><div class="row g-3">@foreach(var e in Model.Where(x=>x.EventDate>=DateTime.Today).OrderBy(x=>x.EventDate)){<div class="col-md-6 col-lg-4"><div class="card event-card h-100"><div class="card-body"><span class="badge bg-primary-subtle text-primary">@e.EventType</span><h4 class="mt-3 fw-bold">@e.EventName</h4><p class="text-secondary">@e.Description</p><div class="small text-secondary">📅 @e.EventDate.ToString("dd MMM yyyy") · @e.StartTime.ToString("hh\:mm")<br/>📍 @e.Location<br/>🏃 @e.DistanceKm km</div><a class="btn btn-dark mt-3" asp-action="Details" asp-route-id="@e.EventID">View event</a></div></div></div>}</div>
