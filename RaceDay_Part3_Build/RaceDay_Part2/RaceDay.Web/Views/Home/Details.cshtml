@model RaceDay.Web.Controllers.HomeController.EventCard
@{ViewData["Title"]=Model.EventName;}<a asp-action="Index" class="text-decoration-none">← All events</a>@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img src="@Model.BannerImageUrl" alt="Event banner for @Model.EventName" class="img-fluid rounded-4 mb-3"/>}<div class="hero mt-3 p-4"><span class="eyebrow">@Model.EventType · @Model.Status</span><h1 class="display-6 fw-bold">@Model.EventName</h1><p>@Model.Description</p><div>📅 @Model.EventDate.ToString("dddd, dd MMMM yyyy") at @Model.StartTime.ToString("hh\:mm") · 📍 @Model.Location · @Model.DistanceKm km</div></div><h2 class="h4 fw-bold mt-4">Available categories</h2><div class="row g-3">@foreach(var c in Model.Categories??new()){<div class="col-md-6"><div class="card card-body"><h5>@c.CategoryName</h5><p class="text-secondary">@c.AgeGroup · R @c.EntryFee.ToString("0.00")</p>@if(Context.Session.GetString("Role")=="Participant"){<form asp-controller="Events" asp-action="Enrol" method="post"><input type="hidden" name="categoryId" value="@c.CategoryID"/><button class="btn btn-warning">Enrol now</button></form>}</div></div>}</div>
