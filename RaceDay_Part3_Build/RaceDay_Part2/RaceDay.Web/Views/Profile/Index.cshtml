@model ProfileVm
@{ViewData["Title"]="My profile";}<h1 class="fw-bold">My profile</h1>@if(ViewBag.ProfilePictureUrl is string picture && !string.IsNullOrWhiteSpace(picture)){<img src="@picture" alt="Your profile picture" width="112" height="112" class="rounded-circle object-fit-cover mb-3"/>}<p class="text-secondary">Keep your contact and emergency details up to date.</p><form method="post" class="profile-form"><label asp-for="PhoneNumber" class="form-label">Phone number</label><input asp-for="PhoneNumber" class="form-control mb-3"/><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control mb-3"/><label asp-for="EmergencyContactName" class="form-label"></label><input asp-for="EmergencyContactName" class="form-control mb-3"/><label asp-for="EmergencyContactPhone" class="form-label"></label><input asp-for="EmergencyContactPhone" class="form-control mb-3"/><button class="btn btn-warning">Save profile</button></form>

<div class="profile-form mt-3"><h5>Profile picture</h5><form asp-action="UploadPicture" method="post" enctype="multipart/form-data"><input type="file" name="file" accept="image/png,image/jpeg,image/webp" class="form-control mb-3" required/><button class="btn btn-outline-dark">Upload picture</button></form><small class="text-secondary">JPG, PNG or WEBP. Upload is handled by the API and stored in Azure Blob Storage.</small></div>
