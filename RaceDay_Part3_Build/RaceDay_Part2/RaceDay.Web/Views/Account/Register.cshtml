@model RegisterVm
@{ViewData["Title"]="Register";}<div class="auth-card"><span class="eyebrow">GET IN THE GAME</span><h1 class="fw-bold">Create your account</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control mb-3"/></div><div class="col"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control mb-3"/></div></div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3"/><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-3"/><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select mb-3"><option>Participant</option><option>Organiser</option></select><label asp-for="OrganiserCode" class="form-label">Organiser code (required for Organiser accounts)</label><input asp-for="OrganiserCode" class="form-control mb-3"/><button class="btn btn-warning w-100">Create account</button></form></div>
